---

import LogoMark from "../components/LogoMark.svelte";

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  // Path or URL of the social preview image (1200x630).
  image?: string;
  imageAlt?: string;
  // Keeps a page out of search results, for tool pages with no content of their own.
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const SITE_NAME = "threadshot.app";

const {
  title = "threadshot.app",
  description = "Turn any Reddit thread or post on X into a clean, phone-sized image. Choose what to show, hide usernames, then download or share it. Free, no account.",
  image = "/og.png",
  imageAlt = "A Reddit thread and a post on X as clean images made with threadshot.app",
  noindex = false,
  jsonLd,
} = Astro.props;

// Canonical host is threadshot.app (Cloudflare Workers), not a preview URL.
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

const REPOSITORY = "https://github.com/yountm/threadshot";
// "2026-10-31T19:05:12.000Z" becomes "2026/10/31, 19:05".
const releasedAt = __BUILD_TIME__.slice(0, 16)
  .replaceAll("-", "/")
  .replace("T", ", ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="border-b border-line">
      <div
        class="mx-auto flex h-14 max-w-[1280px] items-center justify-between px-4 lg:px-8"
      >
        <a href="/" class="flex items-center gap-2.5">
          <LogoMark class="size-7 shrink-0" isSmall />
          <span class="heading text-xl">threadshot.app</span>
          <span class="hidden text-sm font-medium text-ink-2 sm:inline">
            for Reddit and X
          </span>
        </a>
        <nav class="-mr-2.5 flex items-center gap-1">
          <a
            class="nav-link"
            href={`${REPOSITORY}/issues/new`}
            rel="noopener"
            title="Suggestions or issues"
          >
            Feedback
          </a>
          <a
            class="nav-link"
            aria-label="threadshot.app on GitHub"
            href={REPOSITORY}
            rel="noopener"
          >
            <svg class="size-6" viewBox="0 0 256 256" aria-hidden="true">
              <path fill="currentColor" d="M208.31 75.68A59.78 59.78 0 0 0 202.93 28a8 8 0 0 0-6.93-4a59.75 59.75 0 0 0-48 24h-24a59.75 59.75 0 0 0-48-24a8 8 0 0 0-6.93 4a59.78 59.78 0 0 0-5.38 47.68A58.14 58.14 0 0 0 56 104v8a56.06 56.06 0 0 0 48.44 55.47A39.8 39.8 0 0 0 96 192v8H72a24 24 0 0 1-24-24a40 40 0 0 0-40-40a8 8 0 0 0 0 16a24 24 0 0 1 24 24a40 40 0 0 0 40 40h24v16a8 8 0 0 0 16 0v-40a24 24 0 0 1 48 0v40a8 8 0 0 0 16 0v-40a39.8 39.8 0 0 0-8.44-24.53A56.06 56.06 0 0 0 216 112v-8a58.14 58.14 0 0 0-7.69-28.32M200 112a40 40 0 0 1-40 40h-48a40 40 0 0 1-40-40v-8a41.74 41.74 0 0 1 6.9-22.48a8 8 0 0 0 1.1-7.69a43.8 43.8 0 0 1 .79-33.58a43.88 43.88 0 0 1 32.32 20.06a8 8 0 0 0 6.71 3.69h32.35a8 8 0 0 0 6.74-3.69a43.87 43.87 0 0 1 32.32-20.06a43.8 43.8 0 0 1 .77 33.58a8.09 8.09 0 0 0 1 7.65a41.7 41.7 0 0 1 7 22.52Z" />
            </svg>
          </a>
        </nav>
      </div>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-line">
      <div
        class="mx-auto flex max-w-[1280px] flex-col gap-3 px-4 py-5 text-sm text-ink-2 sm:flex-row sm:justify-between sm:gap-8 lg:px-8"
      >
        <p>
          <strong class="font-semibold text-ink">threadshot.app</strong> is not
          affiliated with Reddit or X. Posts and comments belong
          to their authors.
        </p>
        <p
          class="flex flex-col gap-y-1 tabular-nums sm:shrink-0 sm:items-end lg:flex-row lg:gap-x-4"
        >
          {
            __BUILD_COMMIT__ && (
              <span>
                {__BUILD_VERSION__ && (
                  <strong class="font-semibold text-ink">
                    v{__BUILD_VERSION__}
                  </strong>
                )}{" "}
                <span class="font-mono text-xs">
                  ({__BUILD_COMMIT__.slice(0, 7)})
                </span>
              </span>
            )
          }
          <span class="lg:border-l lg:border-line lg:pl-4">
            Released <time datetime={__BUILD_TIME__}>{releasedAt} UTC</time>
          </span>
        </p>
      </div>
    </footer>
  </body>
</html>
